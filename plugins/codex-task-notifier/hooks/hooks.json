{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ],
    "PostToolUse": [
      {
        "matcher": "^(mcp__codex_task_notifier__mark_waiting|mcp__codex_task_notifier__mark_completed)$",
        "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }]
      }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"$PLUGIN_ROOT/dist/lifecycle-hook.js\"", "timeout": 5 }] }
    ]
  }
}
