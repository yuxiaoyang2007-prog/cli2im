{
  "name": "cli2im",
  "version": "1.0.0",
  "description": "Bridge CLI AI agents (Claude Code, Codex, Gemini) to IM platforms (Feishu, Telegram) with streaming output, permission gating, and session resume",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuxiaoyang2007-prog/cli2im.git"
  },
  "keywords": [
    "claude-code",
    "codex",
    "gemini",
    "feishu",
    "lark",
    "telegram",
    "bridge",
    "ai-agent",
    "cli",
    "im"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.133",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "sql.js": "^1.11.0",
    "ws": "^8.20.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@openai/codex-sdk": "^0.128.0"
  },
  "peerDependencies": {
    "content-guard": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "content-guard": {
      "optional": true
    }
  }
}
